@model IEnumerable<CourseManagement.Models.Submission>

@{
    ViewData["Title"] = "Danh sách bài nộp";
    var isInstructor = ViewBag.IsInstructor as bool? ?? false;
    var assignmentTitle = ViewBag.AssignmentTitle as string ?? "Bài tập";
    var assignmentId = ViewBag.AssignmentId as int? ?? 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-file-earmark-check me-2"></i>
            Danh sách bài nộp - @assignmentTitle
        </h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">
            @if (isInstructor)
            {
                <p class="mb-0"><i class="bi bi-info-circle me-2"></i>Chưa có sinh viên nào nộp bài.</p>
            }
            else
            {
                <p class="mb-0"><i class="bi bi-info-circle me-2"></i>Bạn chưa nộp bài tập này.</p>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                @if (isInstructor)
                                {
                                    <th><i class="bi bi-person me-1"></i>Sinh viên</th>
                                }
                                <th><i class="bi bi-clock me-1"></i>Thời gian nộp</th>
                                <th><i class="bi bi-file-earmark me-1"></i>File</th>
                                <th><i class="bi bi-chat-left-text me-1"></i>Ghi chú</th>
                                @if (!isInstructor)
                                {
                                    <th><i class="bi bi-gear me-1"></i>Thao tác</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                <tr>
                                    @if (isInstructor)
                                    {
                                        <td>@s.StudentId</td>
                                    }
                                    <td>
                                        <span class="badge bg-info">
                                            @s.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(s.FilePath))
                                        {
                                            <a href="@s.FilePath" download class="btn btn-sm btn-primary">
                                                <i class="bi bi-download"></i> Tải xuống
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Không có file</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(s.Comments))
                                        {
                                            <div class="small">@Html.Raw(s.Comments)</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Không có ghi chú</span>
                                        }
                                    </td>
                                    @if (!isInstructor)
                                    {
                                        <td>
                                            <button type="button" class="btn btn-sm btn-danger"
                                                onclick="confirmDelete(@s.Id, @assignmentId)">
                                                <i class="bi bi-trash"></i> Xóa & Nộp lại
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Assignments" asp-action="Details" asp-route-id="@assignmentId" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>Quay lại bài tập
        </a>
    </div>
</div>

<!-- Form ẩn để xóa bài nộp -->
<form id="deleteForm" method="post" asp-action="Delete" style="display: none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteSubmissionId" />
    <input type="hidden" name="assignmentId" id="deleteAssignmentId" />
</form>

@section Scripts {
    <script>
        function confirmDelete(submissionId, assignmentId) {
            if (confirm('Bạn có chắc chắn muốn xóa bài nộp này?\n\nSau khi xóa, bạn sẽ được chuyển về trang bài tập để nộp lại.')) {
                document.getElementById('deleteSubmissionId').value = submissionId;
                document.getElementById('deleteAssignmentId').value = assignmentId;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}

<style>
    .table th {
        font-weight: 600;
        color: #495057;
    }

    .badge {
        font-weight: 500;
    }
</style>