@model List<CourseManagement.Models.UserManagementViewModel>
@{
    ViewData["Title"] = "Quản lý giảng viên";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4><i class="bi bi-person-badge-fill"></i> Danh sách giảng viên</h4>
    <a asp-action="CreateInstructor" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Thêm giảng viên
    </a>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Tên đăng nhập</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var instructor in Model)
                        {
                            <tr>
                                <td>
                                    <i class="bi bi-person-badge text-primary"></i>
                                    <strong>@instructor.FullName</strong>
                                </td>
                                <td>@instructor.Email</td>
                                <td>@instructor.UserName</td>
                                <td class="text-end">
                                    <a asp-action="EditInstructor" asp-route-id="@instructor.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> Sửa
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger"
                                        onclick="confirmDeleteInstructor('@instructor.Id', '@instructor.FullName')">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Chưa có giảng viên nào trong hệ thống.
    </div>
}

@section Scripts {
    <script>
        function confirmDeleteInstructor(instructorId, instructorName) {
            if (confirm('BẠN CÓ CHẮC CHẮN MUỐN XÓA GIẢNG VIÊN NÀY KHÔNG?\n\n' +
                'Giảng viên: ' + instructorName + '\n\n' +
                'CẢNH BÁO: Hành động này sẽ XÓA VĨNH VIỄN:\n' +
                '- Tài khoản của giảng viên\n' +
                '- TẤT CẢ các khóa học do giảng viên tạo ra\n' +
                '- Tất cả bài tập, nội dung, điểm danh trong các khóa học đó\n' +
                '- Học viên sẽ KHÔNG THỂ truy cập các khóa học này nữa\n\n' +
                'Hành động này KHÔNG THỂ HOÀN TÁC!')) {

                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '@Url.Action("DeleteInstructor", "Admin")';

                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'id';
                idInput.value = instructorId;
                form.appendChild(idInput);

                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token.value;
                    form.appendChild(tokenInput);
                }

                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}

@Html.AntiForgeryToken()