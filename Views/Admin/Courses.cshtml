@model List<CourseManagement.Models.CourseManagementViewModel>
@{
    ViewData["Title"] = "Quản lý khóa học";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-3">
    <h4><i class="bi bi-book-fill"></i> Danh sách khóa học</h4>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Tên khóa học</th>
                            <th>Giảng viên</th>
                            <th class="text-center">Học viên</th>
                            <th class="text-center">Bài tập</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td>
                                    <i class="bi bi-book text-primary"></i>
                                    <strong>@course.ClassName</strong>
                                    @if (!string.IsNullOrEmpty(course.Description))
                                    {
                                        <br />
                                        <small class="text-muted">@course.Description</small>
                                    }
                                </td>
                                <td>
                                    <i class="bi bi-person-badge"></i> @course.InstructorName
                                    <br />
                                    <small class="text-muted">@course.InstructorEmail</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success">@course.StudentCount</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info">@course.AssignmentCount</span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Instructor" asp-action="Students" asp-route-classRoomId="@course.ClassId"
                                        class="btn btn-sm btn-primary">
                                        <i class="bi bi-people"></i> Học viên
                                    </a>
                                    <a asp-controller="Instructor" asp-action="Reports" asp-route-classRoomId="@course.ClassId"
                                        class="btn btn-sm btn-info">
                                        <i class="bi bi-bar-chart"></i> Báo cáo
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal"
                                        data-bs-target="#deleteModal-@course.ClassId">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* Modal xác nhận xóa cho mỗi khóa học *@
    @foreach (var course in Model)
    {
        <div class="modal fade" id="deleteModal-@course.ClassId" tabindex="-1"
            aria-labelledby="deleteModalLabel-@course.ClassId" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="deleteModalLabel-@course.ClassId">
                            <i class="bi bi-exclamation-triangle"></i> Cảnh báo
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">
                            <strong>Bạn có chắc chắn muốn xóa khóa học "@course.ClassName" không?</strong>
                        </p>
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-circle"></i>
                            <strong>Lưu ý:</strong> Nếu xóa khóa học này, tất cả dữ liệu liên quan sẽ bị mất vĩnh viễn, bao gồm:
                            <ul class="mt-2 mb-0">
                                <li>Danh sách học viên (@course.StudentCount học viên)</li>
                                <li>Bài tập và bài nộp (@course.AssignmentCount bài tập)</li>
                                <li>Điểm danh và nội dung khóa học</li>
                                <li>Giảng viên và Admin sẽ không thể nhìn thấy khóa học này nữa</li>
                            </ul>
                        </div>
                        <p class="text-danger mb-0">
                            <strong>Hành động này không thể hoàn tác!</strong>
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle"></i> Quay lại
                        </button>
                        <form asp-action="DeleteCourse" asp-controller="Admin" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@course.ClassId" />
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Tiếp tục xóa
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Chưa có khóa học nào trong hệ thống.
    </div>
}