@model CourseManagement.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">Tổng giảng viên</h6>
                        <h2 class="mb-0">@Model.TotalInstructors</h2>
                    </div>
                    <i class="bi bi-person-badge-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">Tổng học viên</h6>
                        <h2 class="mb-0">@Model.TotalStudents</h2>
                    </div>
                    <i class="bi bi-people-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">Tổng khóa học</h6>
                        <h2 class="mb-0">@Model.TotalCourses</h2>
                    </div>
                    <i class="bi bi-book-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-0">Tổng ghi danh</h6>
                        <h2 class="mb-0">@Model.TotalEnrollments</h2>
                    </div>
                    <i class="bi bi-clipboard-check-fill" style="font-size: 3rem; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-bar-chart-fill"></i> Thống kê theo giảng viên</h5>
            </div>
            <div class="card-body">
                @if (Model.InstructorStats.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Giảng viên</th>
                                    <th>Email</th>
                                    <th class="text-center">Số khóa học</th>
                                    <th class="text-center">Tổng học viên</th>
                                    <th class="text-center">Trung bình</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stat in Model.InstructorStats)
                                {
                                    <tr>
                                        <td>
                                            <i class="bi bi-person-circle"></i>
                                            <strong>@stat.InstructorName</strong>
                                        </td>
                                        <td>@stat.Email</td>
                                        <td class="text-center">
                                            <span class="badge bg-primary">@stat.CourseCount</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-success">@stat.TotalStudents</span>
                                        </td>
                                        <td class="text-center">
                                            @if (stat.CourseCount > 0)
                                            {
                                                <span class="badge bg-info">@Math.Round((double)stat.TotalStudents / stat.CourseCount, 1) học viên/khóa</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Chưa có dữ liệu thống kê
                    </div>
                }
            </div>
        </div>
    </div>
</div>
