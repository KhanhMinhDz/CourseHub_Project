@model CourseManagement.Models.ReportsByClassViewModel

@{
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
    ViewData["Title"] = "Báo cáo & Thống kê";
}

<!-- Page Header -->
<div class="dashboard-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="mb-0">
                <i class="bi bi-bar-chart-fill me-2"></i>Báo cáo & Thống kê
            </h1>
        </div>
        <div>
            <a href="@Url.Action("ExportToExcel", "Instructor")" class="btn btn-success">
                <i class="bi bi-file-earmark-excel me-1"></i>Xuất báo cáo
            </a>
        </div>
    </div>

    <p class="text-muted mb-0">
        <i class="bi bi-info-circle me-1"></i>Bảng điểm tổng hợp của tất cả học viên theo từng lớp học
    </p>
</div>

<!-- Reports by Class -->
@if (Model.ClassReports.Any())
{
    @foreach (var classReport in Model.ClassReports)
    {
        <div class="dashboard-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">
                    <i class="bi bi-book me-2 text-primary"></i>@classReport.ClassName
                </h3>
                <a asp-action="Edit" asp-route-id="@classReport.ClassId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-eye me-1"></i>Xem chi tiết lớp
                </a>
            </div>

            @if (classReport.Students.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-sm">
                        <thead class="table-light">
                            <tr>
                                <th rowspan="2" class="align-middle text-center" style="min-width: 50px;">
                                    <i class="bi bi-hash"></i>
                                </th>
                                <th rowspan="2" class="align-middle" style="min-width: 200px;">
                                    <i class="bi bi-person-fill me-1"></i>Họ tên
                                </th>
                                @if (classReport.AttendanceSessions.Any())
                                {
                                    <th colspan="@classReport.AttendanceSessions.Count" class="text-center bg-success bg-opacity-10">
                                        <i class="bi bi-calendar-check me-1"></i>Điểm danh
                                    </th>
                                }
                                @if (classReport.Assignments.Any())
                                {
                                    <th colspan="@classReport.Assignments.Count" class="text-center bg-info bg-opacity-10">
                                        <i class="bi bi-clipboard-check me-1"></i>Bài tập
                                    </th>
                                }
                                <th rowspan="2" class="align-middle text-center bg-warning bg-opacity-25" style="min-width: 100px;">
                                    <i class="bi bi-star-fill me-1"></i>Điểm TB
                                </th>
                            </tr>
                            <tr>
                                @if (classReport.AttendanceSessions.Any())
                                {
                                    @foreach (var session in classReport.AttendanceSessions)
                                    {
                                        <th class="text-center" style="min-width: 80px;">
                                            <small>
                                                @session.CreatedAt.ToString("dd/MM")
                                                <br>
                                                <span class="text-muted">@session.CreatedAt.ToString("HH:mm")</span>
                                            </small>
                                        </th>
                                    }
                                }
                                @foreach (var assignment in classReport.Assignments)
                                {
                                    <th class="text-center" style="min-width: 120px;">
                                        <small>
                                            @assignment.Title
                                            @{
                                                var isQuiz = classReport.Students.FirstOrDefault()?.AssignmentGrades
                                                .GetValueOrDefault(assignment.Id)?.IsQuiz ?? false;
                                            }
                                            @if (isQuiz)
                                            {
                                                <span class="badge bg-success ms-1">TN</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary ms-1">TL</span>
                                            }
                                        </small>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 1;
                                foreach (var student in classReport.Students)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@index</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle me-2">
                                                    @student.StudentName.Substring(0, 1).ToUpper()
                                                </div>
                                                <strong>@student.StudentName</strong>
                                            </div>
                                        </td>
                                        @if (classReport.AttendanceSessions.Any())
                                        {
                                            @foreach (var session in classReport.AttendanceSessions)
                                            {
                                                var status = student.AttendanceStatuses.FirstOrDefault(s => s.SessionId == session.Id);
                                                <td class="text-center">
                                                    @if (status != null && status.IsPresent)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success fs-5"
                                                            title="Có mặt lúc @status.AttendedAt?.ToString("HH:mm")"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-x-circle-fill text-danger fs-5" title="Vắng"></i>
                                                    }
                                                </td>
                                            }
                                        }
                                        @foreach (var assignment in classReport.Assignments)
                                        {
                                            var grade = student.AssignmentGrades.GetValueOrDefault(assignment.Id);
                                            <td class="text-center">
                                                @if (grade != null && grade.HasSubmitted)
                                                {
                                                    if (grade.Score.HasValue)
                                                    {
                                                        if (grade.IsQuiz)
                                                        {
                                                            <span class="badge bg-success">
                                                                @grade.Score.Value.ToString("F2")/10
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-primary">
                                                                @grade.Score.Value.ToString("F2")/10
                                                            </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">
                                                            <i class="bi bi-dash-circle"></i> Chưa chấm
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        <i class="bi bi-x-circle"></i> Chưa nộp
                                                    </span>
                                                }
                                            </td>
                                        }
                                        <td class="text-center fw-bold bg-warning bg-opacity-10">
                                            <span class="badge bg-warning text-dark">
                                                @student.AverageScore.ToString("F2")
                                            </span>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Class Statistics -->
                <div class="row mt-3">
                    <div class="col-md-3 col-6 mb-2">
                        <div class="card text-center border-primary h-100">
                            <div class="card-body py-2">
                                <i class="bi bi-people-fill text-primary" style="font-size: 1.5rem;"></i>
                                <h5 class="mt-1 mb-0">@classReport.Students.Count</h5>
                                <small class="text-muted">Tổng học viên</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-2">
                        <div class="card text-center border-success h-100">
                            <div class="card-body py-2">
                                <i class="bi bi-clipboard-check-fill text-success" style="font-size: 1.5rem;"></i>
                                <h5 class="mt-1 mb-0">@classReport.Assignments.Count</h5>
                                <small class="text-muted">Tổng bài tập</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-2">
                        <div class="card text-center border-warning h-100">
                            <div class="card-body py-2">
                                <i class="bi bi-star-fill text-warning" style="font-size: 1.5rem;"></i>
                                <h5 class="mt-1 mb-0">
                                    @if (classReport.Students.Any())
                                    {
                                        @classReport.Students.Average(s => s.AverageScore).ToString("F2")
                                    }
                                    else
                                    {
                                        <text>0.00</text>
                                    }
                                </h5>
                                <small class="text-muted">Điểm TB lớp</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6 mb-2">
                        <div class="card text-center border-info h-100">
                            <div class="card-body py-2">
                                <i class="bi bi-graph-up-arrow text-info" style="font-size: 1.5rem;"></i>
                                <h5 class="mt-1 mb-0">
                                    @{
                                        var totalSubmissions = classReport.Students.Sum(s =>
                                        s.AssignmentGrades.Values.Count(g => g.HasSubmitted));
                                        var totalPossible = classReport.Students.Count * classReport.Assignments.Count;
                                        var completionRate = totalPossible > 0
                                        ? (totalSubmissions * 100.0 / totalPossible)
                                        : 0;
                                    }
                                    @completionRate.ToString("F1")%
                                </h5>
                                <small class="text-muted">Tỷ lệ hoàn thành</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #dee2e6;"></i>
                    <p class="text-muted mt-2 mb-0">Chưa có học viên nào ghi danh vào lớp này</p>
                </div>
            }
        </div>
    }

    <!-- Overall Statistics -->
    <div class="dashboard-card bg-light">
        <h4 class="mb-3">
            <i class="bi bi-graph-up me-2"></i>Thống kê tổng quan
        </h4>
        <div class="row">
            <div class="col-md-3 col-6 mb-3">
                <div class="card text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-mortarboard-fill text-primary" style="font-size: 2rem;"></i>
                        <h4 class="mt-2">@Model.ClassReports.Count</h4>
                        <p class="text-muted mb-0">Tổng số lớp</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="card text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-people-fill text-success" style="font-size: 2rem;"></i>
                        <h4 class="mt-2">@Model.ClassReports.Sum(c => c.Students.Count)</h4>
                        <p class="text-muted mb-0">Tổng học viên</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="card text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-clipboard-fill text-warning" style="font-size: 2rem;"></i>
                        <h4 class="mt-2">@Model.ClassReports.Sum(c => c.Assignments.Count)</h4>
                        <p class="text-muted mb-0">Tổng bài tập</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-3">
                <div class="card text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-star-fill text-info" style="font-size: 2rem;"></i>
                        <h4 class="mt-2">
                            @{
                                var allStudents = Model.ClassReports.SelectMany(c => c.Students).ToList();
                                var overallAverage = allStudents.Any() ? allStudents.Average(s => s.AverageScore) : 0;
                            }
                            @overallAverage.ToString("F2")
                        </h4>
                        <p class="text-muted mb-0">Điểm TB toàn khóa</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="dashboard-card text-center py-5">
        <i class="bi bi-clipboard-data" style="font-size: 4rem; color: #dee2e6;"></i>
        <h4 class="mt-3 text-muted">Chưa có dữ liệu</h4>
        <p class="text-muted">Báo cáo sẽ xuất hiện khi có học viên ghi danh vào các lớp học của bạn</p>
        <a asp-controller="Instructor" asp-action="Index" class="btn btn-primary mt-3">
            <i class="bi bi-plus-circle me-1"></i>Tạo lớp học mới
        </a>
    </div>
}

<style>
    .avatar-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .table-sm {
        font-size: 0.85rem;
    }

    .table-sm th {
        background-color: #f8f9fa;
        font-weight: 600;
    }

    .dashboard-card {
        background: white;
        border-radius: 10px;
        padding: 1.5rem;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .table-responsive {
        max-height: 500px;
        overflow-y: auto;
    }
</style>
