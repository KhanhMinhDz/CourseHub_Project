@model IEnumerable<CourseManagement.Models.Assignment>

@{
    ViewData["Title"] = "Quản lý bài tập";
    var classId = ViewBag.ClassId as int? ?? 0;
    var assignments = Model.ToList();
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-2">
                <i class="bi bi-journal-text me-2 text-primary"></i>Quản lý bài tập
            </h1>
            <p class="text-muted mb-0">
                <i class="bi bi-info-circle me-1"></i>Tổng số: <strong>@assignments.Count</strong> bài tập
            </p>
        </div>
        <div>
            <a asp-action="Create" asp-route-classId="@classId" class="btn btn-primary btn-lg shadow-sm">
                <i class="bi bi-plus-circle me-2"></i>Tạo bài tập mới
            </a>
        </div>
    </div>

    @if (assignments.Any())
    {
        <!-- Assignments Grid -->
        <div class="row g-4">
            @foreach (var assignment in assignments)
            {
                // Tính số ngày đến hạn
                var daysUntilDue = assignment.DueDate.HasValue
                ? (assignment.DueDate.Value.Date - DateTime.Now.Date).Days
                : (int?)null;
                var isPastDue = assignment.DueDate.HasValue && assignment.DueDate.Value < DateTime.Now;
                var isUpcoming = daysUntilDue.HasValue && daysUntilDue.Value <= 3 && daysUntilDue.Value >= 0;

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm hover-card">
                        <div class="card-header bg-gradient-primary text-white">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title mb-0">
                                    <i class="bi bi-file-earmark-text me-2"></i>@assignment.Title
                                </h5>
                                @if (isPastDue)
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-exclamation-triangle"></i> Quá hạn
                                    </span>
                                }
                                else if (isUpcoming)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-clock"></i> Sắp hết hạn
                                    </span>
                                }
                                else if (assignment.DueDate.HasValue)
                                {
                                    <span class="badge bg-info">
                                        <i class="bi bi-calendar-check"></i> Còn hạn
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="card-body">
                            <!-- Description Preview -->
                            @if (!string.IsNullOrEmpty(assignment.Description))
                            {
                    <div class="mb-3 description-preview">
                        @Html.Raw(assignment.Description.Length > 100
                                                ? assignment.Description.Substring(0, 100) + "..."
                                                : assignment.Description)
                    </div>
                                        }
                            else
                            {
                                <p class="text-muted fst-italic">Chưa có mô tả</p>
                            }

                            <!-- Assignment Info -->
                            <div class="assignment-info">
                                <div class="info-item mb-2">
                                    <i class="bi bi-calendar-event text-primary me-2"></i>
                                    <small class="text-muted">Tạo ngày:</small>
                                    <strong class="ms-1">@assignment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                                </div>

                                @if (assignment.DueDate.HasValue)
                                {
                                    <div class="info-item mb-2">
                                        <i class="bi bi-alarm text-danger me-2"></i>
                                        <small class="text-muted">Hạn nộp:</small>
                                        <strong class="ms-1 @(isPastDue ? "text-danger" : isUpcoming ? "text-warning" : "")">
                                            @assignment.DueDate.Value.ToString("dd/MM/yyyy HH:mm")
                                        </strong>
                                    </div>

                                    @if (daysUntilDue.HasValue && !isPastDue)
                                    {
                                        <div class="info-item">
                                            <i class="bi bi-hourglass-split text-info me-2"></i>
                                            <small class="text-muted">Còn lại:</small>
                                            <strong class="ms-1">@daysUntilDue ngày</strong>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="info-item mb-2">
                                        <i class="bi bi-infinity text-success me-2"></i>
                                        <span class="text-success"><strong>Không giới hạn thời gian</strong></span>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="card-footer bg-light">
                            <div class="d-grid gap-2">
                                <a asp-action="Details" asp-route-id="@assignment.Id" class="btn btn-outline-primary">
                                    <i class="bi bi-eye me-2"></i>Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5">
            <div class="empty-state">
                <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                <h3 class="text-muted">Chưa có bài tập nào</h3>
                <p class="text-muted mb-4">Hãy tạo bài tập đầu tiên cho lớp học của bạn</p>
                <a asp-action="Create" asp-route-classId="@classId" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle me-2"></i>Tạo bài tập mới
                </a>
            </div>
        </div>
    }
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .hover-card {
        transition: all 0.3s ease;
        border: none;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15) !important;
    }

    .description-preview {
        font-size: 0.9rem;
        color: #666;
        line-height: 1.5;
        max-height: 60px;
        overflow: hidden;
    }

    .description-preview p {
        margin: 0;
    }

    .assignment-info .info-item {
        display: flex;
        align-items: center;
        font-size: 0.9rem;
    }

    .card-header {
        border-bottom: none;
        padding: 1rem 1.25rem;
    }

    .card-header .card-title {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .empty-state i {
        font-size: 5rem;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.35em 0.65em;
    }
</style>